<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    tools:context=".MainActivity">

	<!-- BACKGROUND -->
	<ImageView
		android:id="@+id/backgroundImage"
		android:layout_width="1500dp"
		android:layout_height="1500dp"
		android:src="@drawable/bgtheme1"
		android:scaleType="centerInside"
		android:adjustViewBounds="true"
		android:layout_centerInParent="true" />

	<!-- Title -->
	<TextView
		android:id="@+id/titleText"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Slot Machine"
		android:textColor="#FFF"
		android:textSize="24sp"
		android:textStyle="bold"
		android:layout_centerHorizontal="true"
		android:layout_marginTop="24dp"/>

	<!-- 3x3 Slot Grid -->
	<FrameLayout
		android:id="@+id/slotFrame"
		android:layout_width="match_parent"
		android:layout_height="300dp"
		android:layout_below="@id/titleText"
		android:layout_marginTop="150dp"
		android:layout_centerHorizontal="true">

		<!-- 3x3 Grid Layout -->
		<GridLayout
			android:id="@+id/slotGrid"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:columnCount="3"
			android:rowCount="3"
			android:layout_gravity="center"
			android:orientation="horizontal">

			<!-- Row 1 -->
			<ImageView
				android:id="@+id/slot1_1"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />
			<ImageView
				android:id="@+id/slot1_2"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />
			<ImageView
				android:id="@+id/slot1_3"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />

			<!-- Row 2 -->
			<ImageView
				android:id="@+id/slot2_1"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />
			<ImageView
				android:id="@+id/slot2_2"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />
			<ImageView
				android:id="@+id/slot2_3"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />

			<!-- Row 3 -->
			<ImageView
				android:id="@+id/slot3_1"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />
			<ImageView
				android:id="@+id/slot3_2"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />
			<ImageView
				android:id="@+id/slot3_3"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_columnWeight="1"
				android:layout_rowWeight="1"
				android:layout_margin="2dp"
				android:scaleType="fitCenter" />
		</GridLayout>
	</FrameLayout>

	<!-- Spin Button -->
	<Button
		android:id="@+id/spinButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="SPIN"
		android:textSize="18sp"
		android:textStyle="bold"
		android:layout_below="@id/slotFrame"
		android:layout_centerHorizontal="true"
		android:layout_marginTop="32dp"
		android:padding="16dp"
		android:background="#FF5722"
		android:textColor="#FFF" />

	<!-- Control Buttons -->
	<LinearLayout
		android:id="@+id/controlButtons"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_below="@id/spinButton"
		android:layout_centerHorizontal="true"
		android:layout_marginTop="16dp"
		android:orientation="horizontal"
		android:gravity="center">
		<Button
			android:id="@+id/stopButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="STOP"
			android:paddingHorizontal="16dp"
			android:background="#9E9E9E"
			android:textColor="#FFF" />
		<Button
			android:id="@+id/theme1Button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="THEME 1"
			android:layout_marginStart="12dp"
			android:background="#03A9F4"
			android:textColor="#FFF" />
		<Button
			android:id="@+id/theme2Button"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="THEME 2"
			android:layout_marginStart="12dp"
			android:background="#4CAF50"
			android:textColor="#FFF" />
	</LinearLayout>

</RelativeLayout>